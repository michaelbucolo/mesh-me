# Core app configuration
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""
AUTH_SECRET="replace-me-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
MESH_DIAGNOSTICS_BASE_URL="http://localhost:3000"

# Legacy / backend compatibility
MESHME_SECRET_KEY="change-me-please"
MESHME_TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-secret"
MESHME_BASE_URL="http://127.0.0.1:8000"
MESHME_DEV_SHOW_VERIFY_LINK="true"

# Secret storage
# Use a random 32-byte base64 value in production. Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_DATA_ENCRYPTION_KEY=""

# Abuse prevention
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Transactional email
# Used for password reset and email verification delivery. Resend can be installed from Vercel Marketplace.
RESEND_API_KEY=""
PASSWORD_RESET_FROM_EMAIL="Mesh.me <security@meshs.me>"
EMAIL_VERIFICATION_FROM_EMAIL="Mesh.me <hello@meshs.me>"
RESEND_FROM_EMAIL=""

# Adult content verification
# NSFW is hidden by default. To enable adult opt-in, configure a third-party
# age/ID verifier and have it POST signed status updates to:
# /api/adult-verification/callback
ADULT_VERIFICATION_PROVIDER_URL=""
ADULT_VERIFICATION_PROVIDER_NAME=""
ADULT_VERIFICATION_WEBHOOK_SECRET=""

# Connected accounts / OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub supports either GITHUB_OAUTH_CLIENT_* (preferred) or GITHUB_CLIENT_*
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# TikTok supports either TIKTOK_CLIENT_KEY (preferred) or TIKTOK_CLIENT_ID
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""
PATREON_CLIENT_ID=""
PATREON_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""

# Optional billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring Stripe Price IDs for Mesh Pro Checkout.
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
# Optional fallback URLs if server-side Checkout is not yet provisioned.
STRIPE_MONTHLY_PAYMENT_LINK=""
STRIPE_YEARLY_PAYMENT_LINK=""
