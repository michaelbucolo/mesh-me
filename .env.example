# Core app configuration
DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""
AUTH_SECRET="replace-me-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
MESH_DIAGNOSTICS_BASE_URL="http://localhost:3000"

# Legacy / backend compatibility
MESHME_SECRET_KEY="change-me-please"
MESHME_TOKEN_ENCRYPTION_KEY="change-me-to-a-long-random-secret"
MESHME_BASE_URL="http://127.0.0.1:8000"

# Secret storage — REQUIRED for connecting any account.
#
# OAuth access and refresh tokens are encrypted with this key before they are
# stored. Without it the callback refuses to write a connection at all (storing
# tokens in cleartext would be worse), so an unset or unreadable key makes every
# platform fail at the last step, AFTER the person has already authorized.
#
# A 32-byte key. Either encoding is accepted, so use whichever you already have:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_DATA_ENCRYPTION_KEY=""

# Abuse prevention
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Transactional email
# Used for password reset and email verification delivery. Resend can be installed from Vercel Marketplace.
RESEND_API_KEY=""
PASSWORD_RESET_FROM_EMAIL="Mesh.me <security@meshs.me>"
EMAIL_VERIFICATION_FROM_EMAIL="Mesh.me <hello@meshs.me>"
RESEND_FROM_EMAIL=""

# Adult content verification
# NSFW is hidden by default. To enable adult opt-in, configure a third-party
# age/ID verifier and have it POST signed status updates to:
# /api/adult-verification/callback
ADULT_VERIFICATION_PROVIDER_URL=""
ADULT_VERIFICATION_PROVIDER_NAME=""
ADULT_VERIFICATION_WEBHOOK_SECRET=""

# ─── Connected accounts / OAuth ──────────────────────────────────────────────
#
# THIS IS THE WHOLE REASON A CONNECT BUTTON DOES OR DOES NOT WORK.
#
# mesh.me never asks for a password on another service. Connecting is an OAuth
# redirect, and a redirect needs two things that only the deployment's owner can
# supply, PER PLATFORM:
#
#   1. The client id + secret below, set on the deployment (and redeployed).
#   2. The callback URL registered in that platform's developer app:
#
#        https://www.meshs.me/api/auth/<platform>/callback
#
#      ...where <platform> is the lowercase id in the comment beside each pair
#      (youtube, discord, twitter, twitch, instagram, facebook, linkedin,
#      reddit, tiktok, pinterest, snapchat, threads). It must match BYTE FOR
#      BYTE — a trailing slash or a missing "www" is a rejected login.
#
# Until both exist for a platform, One Account shows it as "Needs setup" with
# these exact variable names, and its Connect button stays disabled rather than
# sending someone into a broken redirect. That is the honest state, not a bug.
#
# The list is exactly the twelve platforms in src/lib/platforms.ts. Adding a
# variable here for a platform that is not on that list does nothing.

# User-Agent sent on outbound platform API calls. Reddit's API Terms require a
# unique, descriptive User-Agent; set this to Reddit's preferred form once you
# have a developer username, e.g. "web:app.meshs.me:v1.0 (by /u/your-username)".
MESH_API_USER_AGENT=""

# youtube — Google Cloud console, YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# discord — https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# twitter (shown as X) — https://developer.x.com, OAuth 2.0 with PKCE
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
# twitch — https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# facebook — https://developers.facebook.com/apps
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# instagram — same Meta app; supports INSTAGRAM_APP_* (preferred) or INSTAGRAM_CLIENT_*
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# threads — same Meta app; falls back to FACEBOOK_APP_* when unset
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
# linkedin — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# reddit — https://www.reddit.com/prefs/apps (type: web app)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
# tiktok — https://developers.tiktok.com; supports TIKTOK_CLIENT_KEY (preferred) or TIKTOK_CLIENT_ID
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# pinterest — https://developers.pinterest.com/apps
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
# snapchat — https://developers.snap.com (Login Kit)
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

# Optional billing
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring Stripe Price IDs for MeshPro Checkout.
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
# Optional fallback URLs if server-side Checkout is not yet provisioned.
STRIPE_MONTHLY_PAYMENT_LINK=""
STRIPE_YEARLY_PAYMENT_LINK=""

# ── PUBLIC SUPPLY ────────────────────────────────────────────────────────────
# Content mesh.me fetches from platforms' OFFICIAL APIs using its OWN app
# credentials, so a brand-new account has something to read without connecting
# anything. Every one of these is OPTIONAL: an unset key disables that lane,
# which then reports "not_configured" and stores nothing. No lane ever invents
# content to cover a missing key.
#
# Two of the four lanes need no credential at all — Bluesky's public AppView and
# Mastodon's trends endpoints are open — so the Flow has real supply out of the
# box even with none of this set.

# YouTube Data API v3 key (Google Cloud console, "YouTube Data API v3").
# Quota is per PROJECT and shared app-wide. The trending lane is one cheap call;
# do not add a search-based lane without re-reading the quota table first.
YOUTUBE_API_KEY=

# Twitch app access token is minted from these via client_credentials — the
# SAME pair the connected-account flow already uses. It carries no scopes and
# reads nothing private.
# TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET are declared above with the OAuth keys.

# Optional. Comma-separated Mastodon servers to read trends from. Defaults to a
# small general-interest set. Curation, not a credential.
MASTODON_INSTANCES=

# Shared secret for POST/GET /api/public-supply/refresh. UNSET MEANS THE SECRET
# PATH IS DISABLED, not open — an unset secret compared against a missing header
# would otherwise authorise everyone. Signed-in admins can always trigger a
# refresh regardless.
PUBLIC_SUPPLY_CRON_SECRET=
