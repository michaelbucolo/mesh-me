generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  bio          String?
  location     String?
  website      String?
  avatarUrl    String?
  bannerUrl    String?
  accentColor  String   @default("#6366f1")
  isPublic     Boolean  @default(false)
  isAdmin      Boolean  @default(false)
  isVerified   Boolean  @default(false)
  isSuspended  Boolean  @default(false)
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts                      Post[]
  comments                   Comment[]
  reactions                  Reaction[]
  flowImpressions            FlowImpression[]
  followers                  Follow[]                    @relation("following")
  following                  Follow[]                    @relation("follower")
  sentMessages               Message[]                   @relation("sender")
  threadMembers              ThreadMember[]
  notifications              Notification[]              @relation("recipient")
  notificationPreference     UserNotificationPreference?
  pushSubscriptions          PushSubscription[]
  actorNotifs                Notification[]              @relation("actor")
  reports                    Report[]                    @relation("reporter")
  reportedUser               Report[]                    @relation("reportedUser")
  blocks                     Block[]                     @relation("blocker")
  blockedBy                  Block[]                     @relation("blocked")
  mutes                      Mute[]                      @relation("muter")
  mutedBy                    Mute[]                      @relation("muted")
  communityMemberships       CommunityMember[]
  interests                  UserInterest[]
  links                      UserLink[]
  adminLogs                  AdminLog[]
  savedPosts                 SavedPost[]
  savedFlowItems             SavedFlowItem[]
  connectedAccounts          ConnectedAccount[]
  feedPreference             FeedPreference?
  achievements               UserAchievement[]
  meshiPreference            MeshiPreference?
  meshCosmetics              MeshCosmetic[]
  meshPrivacy                MeshPrivacy?
  sessions                   Session[]
  authIdentities             AuthIdentity[]
  globalMeshMember           GlobalMeshMember?
  activeTitle                String?
  isMeshPro                  Boolean                     @default(false)
  meshProSince               DateTime?
  stripeCustomerId           String?                     @unique
  stripeSubscriptionId       String?
  signupNumber               Int?
  // Privacy toggles
  showInDiscovery            Boolean                     @default(false)
  hideActivityStatus         Boolean                     @default(false)
  readReceipts               Boolean                     @default(false)
  ghostMode                  Boolean                     @default(false)
  /// Algorithm Studio weights, as the same JSON string the ranker already
  /// validates with normalizeStudioWeights(). Stored on the account rather than
  /// in localStorage because it is the thing MeshPro sells — "your algorithm,
  /// literally" — and a paid control that a new phone silently forgets is not
  /// one. Nullable: absent means the account has never tuned it.
  flowStudio                 String?
  // Sensitive-content controls. NSFW is always off unless an adult-verification
  // provider confirms the user is eligible; Mesh.me never stores ID images.
  nsfwEnabled                Boolean                     @default(false)
  adultVerificationStatus    String                      @default("unverified")
  adultVerifiedAt            DateTime?
  adultVerificationExpiresAt DateTime?
  adultVerificationProvider  String?
  adultVerificationRegion    String?
  adultVerificationReference String?
  // Verification tracking
  emailVerified              Boolean                     @default(false)
  phoneVerified              Boolean                     @default(false)
  // Password reset
  resetToken                 String?                     @unique
  resetTokenExpiry           DateTime?
  // Online status: "online" | "dnd" | "busy" | "offline"
  status                     String                      @default("offline")
  lastSeenAt                 DateTime?
  // Account-merge tombstone: set when this account was merged into another
  // mesh.me account. The account stays suspended (never hard-deleted) and this
  // points at the surviving account.
  mergedIntoUserId           String?
  alterEgos                  AlterEgo[]
  emails                     UserEmail[]
  emailVerificationTokens    EmailVerificationToken[]
  phones                     UserPhone[]
  twoFactorMethods           TwoFactorMethod[]
  profileInfo                ProfileInfo?
  hostedMeChatSessions       MeChatSession[]             @relation("sessionHost")
  meChatSessionParticipants  MeChatSessionParticipant[]  @relation("sessionParticipant")
  meChatSessionItems         MeChatSessionItem[]         @relation("sessionItemAuthor")
  meChatSessionVotes         MeChatSessionVote[]         @relation("sessionVoteUser")
  meshNodes                  MeshNode[]
  meChatNotes                MeChatNote[]
  meshEdgesFrom              MeshEdge[]                  @relation("MeshEdgeFromUser")
  contentSources             ContentSource[]
  syncedContent              SyncedContent[]
  syncedInteractions         SyncedInteraction[]
  dataVisibilityPolicies     DataVisibilityPolicy[]
  platformPermissions        PlatformPermission[]
}

model UserInterest {
  id     String @id @default(cuid())
  userId String
  tag    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([tag])
}

model UserLink {
  id     String @id @default(cuid())
  userId String
  label  String
  url    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id            String   @id @default(cuid())
  content       String
  authorId      String
  communityId   String?
  isRepost      Boolean  @default(false)
  repostId      String?
  isPinned      Boolean  @default(false)
  visibility    String   @default("public")
  isNsfw        Boolean  @default(false)
  contentRating String   @default("general")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  repostOf      Post?          @relation("reposts", fields: [repostId], references: [id], onDelete: SetNull)
  reposts       Post[]         @relation("reposts")
  media         PostMedia[]
  comments      Comment[]
  reactions     Reaction[]
  tags          PostTag[]
  reports       Report[]       @relation("reportedPost")
  savedBy       SavedPost[]
  notifications Notification[]

  @@index([authorId])
  @@index([communityId])
  @@index([createdAt])
  @@index([visibility, createdAt])
  @@index([isNsfw, createdAt])
}

model PostMedia {
  id     String @id @default(cuid())
  postId String
  url    String
  type   String @default("image")
  width  Int?
  height Int?
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([tag])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("replies", fields: [parentId], references: [id])
  replies Comment[] @relation("replies")
  reports Report[]  @relation("reportedComment")

  @@index([postId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("like")
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

/// A viewer's PRIVATE Flow signal: reels actually seen (so the ranker never
/// replays them across sessions/devices) and reels privately liked (folded into
/// the viewer's OWN taste — never surfaced to others, never cross-user, never
/// pay-to-win). postId is the feed-card id namespace ("<cuid>" | "platform-<id>"
/// | "feeditem-<id>" | "friend-platform-<id>"), NOT a Post FK. authorKey/format/
/// tags are denormalized at like-time to the exact authorKey(post) the ranker
/// scores on, so taste survives the source item's own retention purge. Only ever
/// queried by the row-owner's own id.
model FlowImpression {
  userId     String
  postId     String
  seenAt     DateTime @default(now())
  liked      Boolean  @default(false)
  authorKey  String?
  format     String?
  tags       String?
  // Watch signal (Reels-style ranking inputs): accumulated on-screen time in
  // ms, and the best video completion fraction (0..1) reached. A tiny watchMs
  // with no like is an implicit "skipped past it" negative signal.
  watchMs    Int      @default(0)
  completion Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, seenAt])
  @@index([userId, liked])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  category    String?
  isPublic    Boolean  @default(true)
  rules       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts   Post[]
  members CommunityMember[]
  reports Report[]          @relation("reportedCommunity")

  @@index([category])
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
}

model MessageThread {
  id                     String            @id @default(cuid())
  title                  String?
  threadType             String            @default("direct")
  sourcePlatform         String            @default("mesh")
  isEncrypted            Boolean           @default(true)
  // For threads mirrored from a connected platform: the owning connection
  // and the platform-side conversation identifier.
  connectedAccountId     String?
  externalConversationId String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  members                ThreadMember[]
  messages               Message[]
  // This was a bare String? for its whole life, so disconnecting a platform
  // left every mirrored DM body sitting in the database with a dangling id —
  // unreachable from any surface, deleted by nothing, and still there after a
  // GDPR erasure or Meta's data-deletion callback. Cascade is the right action
  // and not merely the convenient one: these rows are a COPY of correspondence
  // that lives on the platform. Revoking our access to the platform is exactly
  // the moment our copy stops being ours to keep. Mesh-native threads carry a
  // null here and are untouched.
  connectedAccount       ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, externalConversationId])
  @@index([threadType])
  @@index([sourcePlatform])
  @@index([connectedAccountId])
}

model ThreadMember {
  id                 String        @id @default(cuid())
  userId             String
  threadId           String
  role               String        @default("member")
  notificationsMuted Boolean       @default(false)
  lastRead           DateTime      @default(now())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread             MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([role])
}

model Message {
  id                String        @id @default(cuid())
  content           String
  senderId          String
  threadId          String
  sourcePlatform    String        @default("mesh")
  messageType       String        @default("text")
  sourceUrl         String?
  sourcePostId      String?
  platformPostId    String?
  platformCommentId String?
  // Platform-side message id for messages mirrored from a connected account.
  externalMessageId String?
  metadata          String?
  createdAt         DateTime      @default(now())
  sender            User          @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  thread            MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  // Serves the polled "latest N messages in a thread, newest first" window and
  // the unread scan (threadId + createdAt) without a filesort.
  @@index([threadId, createdAt])
  @@index([sourcePlatform])
  @@index([platformPostId])
  @@index([platformCommentId])
  @@index([externalMessageId])
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  recipientId String
  actorId     String?
  postId      String?
  message     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User  @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([createdAt])
  // Serves the continuously-polled unread count (recipientId + read=false) and
  // the ordered notification page (recipientId ordered by createdAt) directly,
  // without a per-row filter/filesort.
  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}

/// One browser's Web Push subscription. A user has one row per device/browser
/// that granted notification permission; the endpoint is the push service's
/// unique URL for that browser, so it is the natural key. Rows are pruned
/// when the push service reports the subscription dead (404/410).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserNotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  pushEnabled    Boolean  @default(true)
  emailDigest    String   @default("weekly")
  messages       Boolean  @default(true)
  mentions       Boolean  @default(true)
  comments       Boolean  @default(true)
  follows        Boolean  @default(true)
  platformAlerts Boolean  @default(true)
  securityAlerts Boolean  @default(true)
  productUpdates Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id                  String   @id @default(cuid())
  reason              String
  status              String   @default("pending")
  reporterId          String
  reportedUserId      String?
  reportedPostId      String?
  reportedCommentId   String?
  reportedCommunityId String?
  createdAt           DateTime @default(now())

  reporter          User       @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser      User?      @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedPost      Post?      @relation("reportedPost", fields: [reportedPostId], references: [id], onDelete: SetNull)
  reportedComment   Comment?   @relation("reportedComment", fields: [reportedCommentId], references: [id], onDelete: SetNull)
  reportedCommunity Community? @relation("reportedCommunity", fields: [reportedCommunityId], references: [id], onDelete: SetNull)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  // Blocks are stored one-directional but enforced symmetrically, so every
  // read path also looks the pair up from the blocked side. The unique index
  // above only serves blockerId-leading queries; this one keeps the mirrored
  // half off a table scan on the app's hottest reads (feed, explore, search,
  // permalinks, communities).
  @@index([blockedId])
}

model Mute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

/// A bookmark of something seen in the Flow that is NOT a native mesh post —
/// synced platform content or public supply. Stores a SNAPSHOT (title, url,
/// thumbnail, platform, author) rather than a foreign key, because supply
/// rows are pruned on retention schedules (platformFeedItem after 30 days,
/// PublicPost on expiry) — a person's saved list must outlive the cache that
/// fed it. refId is the Flow item's stable id, so re-saving the same thing
/// toggles instead of duplicating.
model SavedFlowItem {
  id           String   @id @default(cuid())
  userId       String
  refId        String
  platform     String?
  title        String?
  url          String?
  thumbnailUrl String?
  authorName   String?
  postType     String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refId])
  @@index([userId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  adminId   String
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ConnectedAccount {
  id               String    @id @default(cuid())
  userId           String
  platform         String
  platformUsername String?
  platformId       String?
  accessToken      String?
  refreshToken     String?
  expiresAt        DateTime?
  // OAuth scopes granted by the platform
  scopes           String?
  isActive         Boolean   @default(true)
  // Last successful sync timestamp
  lastSyncAt       DateTime?
  // Sync status: "idle" | "syncing" | "error" | "rate_limited"
  syncStatus       String    @default("idle")
  syncError        String?
  // Optional association with an alter ego / persona
  alterEgoId       String?
  // Label to distinguish multiple accounts on the same platform
  accountLabel     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  alterEgo            AlterEgo?            @relation(fields: [alterEgoId], references: [id], onDelete: SetNull)
  platformPosts       PlatformPost[]
  platformComments    PlatformComment[]
  platformMedia       PlatformMedia[]
  platformFollowers   PlatformFollower[]
  syncJobs            SyncJob[]
  platformAnalytics   PlatformAnalytics[]
  contentSources      ContentSource[]
  platformPermissions PlatformPermission[]
  platformFeedItems   PlatformFeedItem[]
  // DM threads mirrored from this connection. Cascade: revoking a platform
  // must take the copied correspondence with it.
  mirroredThreads     MessageThread[]

  @@index([userId, platform])
  @@index([platform])
  @@index([alterEgoId])
}

// ─── Cross-Platform Content Sync ────────────────────────────

model PlatformPost {
  id                 String    @id @default(cuid())
  connectedAccountId String
  // Original post ID on the platform
  platformPostId     String
  // Post content / caption / description
  content            String?
  // Post title (YouTube videos, Reddit posts, etc.)
  title              String?
  // Direct URL to the post on the platform
  url                String?
  // Post type: "text" | "image" | "video" | "story" | "reel" | "short" | "tweet" | "thread" | "article" | "pin" | "snap"
  // Real length of the item in seconds, when the platform reports one. The
  // Flow is shorts-and-reels only and this is the sole signal in the pipeline
  // that is a measurement rather than a guess about a URL shape.
  durationSeconds    Int?
  postType           String    @default("text")
  // Engagement metrics
  likeCount          Int       @default(0)
  commentCount       Int       @default(0)
  shareCount         Int       @default(0)
  viewCount          Int       @default(0)
  // Video-specific metrics
  watchTimeSeconds   Int?
  // Post visibility: "public" | "private" | "unlisted" | "friends"
  visibility         String    @default("public")
  // Whether this post was created from mesh.me (cross-posted)
  isFromMesh         Boolean   @default(false)
  // Whether we've imported comments for this post
  commentsImported   Boolean   @default(false)
  // Original publish timestamp from the platform
  publishedAt        DateTime?
  // Thumbnail / preview image URL
  thumbnailUrl       String?
  // Raw JSON metadata from platform API
  rawMetadata        String?
  // Is this post pinned on the platform?
  isPinned           Boolean   @default(false)
  // Sensitive-content classification. Hidden unless the viewer has verified
  // adult access and explicitly enables NSFW in settings.
  isNsfw             Boolean   @default(false)
  contentRating      String    @default("general")
  // Is this a scheduled post?
  isScheduled        Boolean   @default(false)
  scheduledFor       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccount ConnectedAccount  @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  comments         PlatformComment[]
  media            PlatformMedia[]

  @@unique([connectedAccountId, platformPostId])
  @@index([connectedAccountId])
  @@index([publishedAt])
  @@index([postType])
  @@index([isNsfw, publishedAt])
}

// Items pulled from the personalized home / for-you feed of a connected
// platform (content authored by other people, not the account owner).
model PlatformFeedItem {
  id                 String    @id @default(cuid())
  connectedAccountId String
  // Original item ID on the platform
  platformItemId     String
  authorName         String?
  authorUsername     String?
  authorAvatarUrl    String?
  authorUrl          String?
  title              String?
  content            String?
  url                String?
  thumbnailUrl       String?
  mediaUrl           String?
  // "post" | "video" | "image" | "link" | "stream" | "activity"
  durationSeconds    Int?
  postType           String    @default("post")
  likeCount          Int       @default(0)
  commentCount       Int       @default(0)
  isNsfw             Boolean   @default(false)
  contentRating      String    @default("general")
  publishedAt        DateTime?
  fetchedAt          DateTime  @default(now())
  rawMetadata        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformItemId])
  @@index([connectedAccountId, publishedAt])
  @@index([isNsfw, publishedAt])
}

model PlatformComment {
  id                 String  @id @default(cuid())
  connectedAccountId String
  platformPostId     String?
  platformCommentId  String
  // The post this comment belongs to (if synced)
  postId             String?
  // Comment text
  content            String
  // Author info from the platform
  authorName         String?
  authorUsername     String?
  authorAvatarUrl    String?
  // Is this the connected user's own comment?
  isOwnComment       Boolean @default(false)
  // Engagement
  likeCount          Int     @default(0)
  replyCount         Int     @default(0)
  // Parent comment ID (for threaded comments)
  parentCommentId    String?
  // Direct URL to the comment
  url                String?
  // Sentiment: "positive" | "negative" | "neutral" | "question"
  sentiment          String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  post             PlatformPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformCommentId])
  @@index([connectedAccountId])
  @@index([postId])
}

model PlatformMedia {
  id                 String  @id @default(cuid())
  connectedAccountId String
  platformMediaId    String?
  // Associated platform post
  postId             String?
  // Media type: "image" | "video" | "audio" | "gif" | "document"
  mediaType          String  @default("image")
  // URL to the media file
  url                String
  // Thumbnail URL
  thumbnailUrl       String?
  // Alt text / description
  altText            String?
  // Media dimensions
  width              Int?
  height             Int?
  // Duration in seconds (for video/audio)
  durationSeconds    Int?
  // File size in bytes
  fileSizeBytes      Int?
  // MIME type
  mimeType           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  post             PlatformPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@index([postId])
}

model PlatformFollower {
  id                 String  @id @default(cuid())
  connectedAccountId String
  // Platform user ID
  platformUserId     String
  // Username on the platform
  username           String?
  // Display name
  displayName        String?
  // Profile picture URL
  avatarUrl          String?
  // Follower count on that platform
  followerCount      Int?
  // Is this a mutual follow?
  isMutual           Boolean @default(false)
  // Type: "follower" | "following" | "subscriber" | "friend"
  relationshipType   String  @default("follower")
  // Profile URL
  profileUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformUserId])
  @@index([connectedAccountId])
}

model PlatformAnalytics {
  id                 String   @id @default(cuid())
  connectedAccountId String
  // Date for this analytics snapshot
  date               DateTime
  // Follower/subscriber count at this point
  followerCount      Int      @default(0)
  followingCount     Int      @default(0)
  // Engagement metrics for the day
  postCount          Int      @default(0)
  totalLikes         Int      @default(0)
  totalComments      Int      @default(0)
  totalViews         Int      @default(0)
  totalShares        Int      @default(0)
  // Growth metrics
  newFollowers       Int      @default(0)
  lostFollowers      Int      @default(0)
  // Engagement rate (percentage * 100 for precision)
  engagementRate     Int?
  // Top-performing post ID for the day
  topPostId          String?
  // Raw JSON for platform-specific analytics
  rawData            String?

  createdAt DateTime @default(now())

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, date])
  @@index([connectedAccountId])
  @@index([date])
}

model SyncJob {
  id                 String    @id @default(cuid())
  connectedAccountId String
  // Sync type: "full" | "incremental" | "posts" | "comments" | "followers" | "analytics" | "media"
  syncType           String    @default("full")
  // Status: "pending" | "running" | "completed" | "failed" | "cancelled"
  status             String    @default("pending")
  // Progress (0-100)
  progress           Int       @default(0)
  // Items synced / total
  itemsSynced        Int       @default(0)
  totalItems         Int?
  // Error message if failed
  error              String?
  // Timing
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@index([status])
}

model FeedPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  layout       String   @default("cards")
  sources      String   @default("all")
  // Viewer-side muted mesh sources (JSON array of "author:{userId}" /
  // "account:{connectedAccountId}" keys). Muting is a private preference: it
  // drops a source's content from THIS viewer's own mesh model and Flow
  // candidates only — it never changes what anyone else can see.
  mutedSources String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Unified Data Model ────────────────────────────────────

model MeshNode {
  id          String   @id @default(cuid())
  userId      String
  nodeType    String
  sourceType  String   @default("mesh")
  sourceId    String?
  label       String
  description String?
  imageUrl    String?
  metadata    String   @default("{}")
  visibility  String   @default("private")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingEdges MeshEdge[] @relation("MeshNodeOutgoing")
  incomingEdges MeshEdge[] @relation("MeshNodeIncoming")

  @@index([userId, nodeType])
  @@index([sourceType, sourceId])
}

model MeshEdge {
  id         String   @id @default(cuid())
  userId     String
  fromNodeId String
  toNodeId   String
  edgeType   String
  strength   Int      @default(100)
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation("MeshEdgeFromUser", fields: [userId], references: [id], onDelete: Cascade)
  fromNode MeshNode @relation("MeshNodeOutgoing", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   MeshNode @relation("MeshNodeIncoming", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([userId, fromNodeId, toNodeId, edgeType])
  @@index([userId, edgeType])
}

model ContentSource {
  id                 String    @id @default(cuid())
  userId             String
  connectedAccountId String?
  sourceType         String
  sourceId           String
  sourceUrl          String?
  sourceAuthorId     String?
  sourceAuthorName   String?
  sourceCreatedAt    DateTime?
  ingestState        String    @default("active")
  metadata           String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)
  syncedContent    SyncedContent[]

  @@unique([userId, sourceType, sourceId])
  @@index([connectedAccountId])
}

model SyncedContent {
  id              String   @id @default(cuid())
  userId          String
  contentSourceId String
  canonicalType   String
  textContent     String?
  title           String?
  mediaJson       String   @default("[]")
  permalink       String?
  ownership       String   @default("external")
  actionSupport   String   @default("{}")
  syncStatus      String   @default("synced")
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentSource ContentSource       @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)
  interactions  SyncedInteraction[]

  @@index([userId, canonicalType])
  @@index([syncStatus, syncedAt])
}

model SyncedInteraction {
  id               String    @id @default(cuid())
  userId           String
  syncedContentId  String
  interactionType  String
  actorSourceId    String?
  actorDisplayName String?
  value            Int?
  body             String?
  happenedAt       DateTime?
  metadata         String    @default("{}")
  createdAt        DateTime  @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncedContent SyncedContent @relation(fields: [syncedContentId], references: [id], onDelete: Cascade)

  @@index([userId, interactionType])
  @@index([syncedContentId, happenedAt])
}

model PlatformPermission {
  id                 String    @id @default(cuid())
  userId             String
  connectedAccountId String?
  platform           String
  permissionKey      String
  permissionState    String    @default("granted")
  grantedAt          DateTime  @default(now())
  revokedAt          DateTime?
  source             String    @default("oauth_scope")
  metadata           String    @default("{}")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, platform, permissionKey, connectedAccountId])
  @@index([connectedAccountId, permissionState])
}

model DataVisibilityPolicy {
  id             String    @id @default(cuid())
  userId         String
  entityType     String
  entityId       String?
  visibility     String
  allowDiscovery Boolean   @default(false)
  allowAnalytics Boolean   @default(false)
