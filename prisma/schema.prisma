  birthday           String?
  gender             String?
  pronouns           String?
  hometown           String?
  currentCity        String?
  relationshipStatus String?
  // Contact info (beyond primary email/phone)
  publicEmail        String?
  publicPhone        String?

  // Per-field privacy: JSON map of field → "public" | "friends" | "personal"
  // e.g. { "birthday": "friends", "workplace": "public", "publicPhone": "personal" }
  fieldPrivacy String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

