  id         String    @id @default(cuid())
  userId     String
  // Method type: "email" | "sms" | "totp" | "passkey"
  method     String
  // For TOTP: encrypted secret; for passkey: credential ID
  secret     String?
  // For passkey: public key
  publicKey  String?
  // User-friendly label (e.g. "My iPhone", "Google Authenticator")
  label      String?
  isEnabled  Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Account Merge Requests ─────────────────────────────────

model AccountMergeRequest {
  id              String    @id @default(cuid())
  // The account that will remain (primary)
  primaryUserId   String
  // The identifier (email or username) the requester entered for the account
  // to merge in. Stored exactly as entered (normalized) so the requester's own
  // view never reveals the resolved account's real email address.
  secondaryEmail  String
  // The resolved account that will be merged in (secondary → becomes alter
  // ego). Null when the identifier didn't resolve — the row is still created
  // so request creation never acts as an account-existence oracle.
  secondaryUserId String?
  // Status: "pending" (awaiting secondary-side approval) | "verified"
  // (secondary side proven via credentials or in-session approval) |
  // "completed" | "declined" | "cancelled" | "expired"
  status          String    @default("pending")
  // Legacy email-token flow artifact; unused by the two-party flow.
  verifyToken     String?
  // When the secondary side was proven (credential check or B's approval).
  approvedAt      DateTime?
  // Pending requests expire; treated as createdAt + 7 days when null (legacy rows).
  expiresAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([primaryUserId])
  @@index([secondaryEmail])
  @@index([secondaryUserId])
}

// ─── Profile Info (Facebook-level fields with per-field privacy) ──

