generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  displayName    String
  passwordHash   String
  bio            String?
  location       String?
  website        String?
  avatarUrl      String?
  bannerUrl      String?
  accentColor    String   @default("#6366f1")
  isPublic       Boolean  @default(true)
  isAdmin        Boolean  @default(false)
  isVerified     Boolean  @default(false)
  isSuspended    Boolean  @default(false)
  onboarded      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  followers      Follow[]       @relation("following")
  following      Follow[]       @relation("follower")
  sentMessages   Message[]      @relation("sender")
  threadMembers  ThreadMember[]
  notifications  Notification[] @relation("recipient")
  actorNotifs    Notification[] @relation("actor")
  reports        Report[]       @relation("reporter")
  reportedUser   Report[]       @relation("reportedUser")
  blocks         Block[]        @relation("blocker")
  blockedBy      Block[]        @relation("blocked")
  mutes          Mute[]         @relation("muter")
  mutedBy        Mute[]         @relation("muted")
  communityMemberships CommunityMember[]
  interests      UserInterest[]
  links          UserLink[]
  adminLogs      AdminLog[]
  savedPosts     SavedPost[]
  connectedAccounts ConnectedAccount[]
  feedPreference FeedPreference?
  achievements   UserAchievement[]
  meshiPreference MeshiPreference?
  meshCosmetics  MeshCosmetic[]
  meshPrivacy    MeshPrivacy?
  sessions       Session[]
  globalMeshMember GlobalMeshMember?
  activeTitle    String?
  isMeshPro      Boolean  @default(false)
  meshProSince   DateTime?
  stripeCustomerId    String?  @unique
  stripeSubscriptionId String?
  signupNumber   Int?
  // Privacy toggles
  showInDiscovery  Boolean @default(true)
  hideActivityStatus Boolean @default(false)
  readReceipts     Boolean @default(true)
  // Verification tracking
  emailVerified    Boolean @default(false)
  phoneVerified    Boolean @default(false)
  // Password reset
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  // Online status: "online" | "dnd" | "busy" | "offline"
  status         String   @default("offline")
  lastSeenAt     DateTime?
  alterEgos      AlterEgo[]
  emails         UserEmail[]
  phones         UserPhone[]
  twoFactorMethods TwoFactorMethod[]
  profileInfo    ProfileInfo?
}

model UserInterest {
  id       String @id @default(cuid())
  userId   String
  tag      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([tag])
}

model UserLink {
  id       String @id @default(cuid())
  userId   String
  label    String
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id          String      @id @default(cuid())
  content     String
  authorId    String
  communityId String?
  isRepost    Boolean     @default(false)
  repostId    String?
  isPinned    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community   Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  repostOf    Post?       @relation("reposts", fields: [repostId], references: [id], onDelete: SetNull)
  reposts     Post[]      @relation("reposts")
  media       PostMedia[]
  comments    Comment[]
  reactions   Reaction[]
  tags        PostTag[]
  reports     Report[]    @relation("reportedPost")
  savedBy     SavedPost[]
  notifications Notification[]

  @@index([authorId])
  @@index([communityId])
  @@index([createdAt])
}

model PostMedia {
  id       String @id @default(cuid())
  postId   String
  url      String
  type     String @default("image")
  width    Int?
  height   Int?
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tag    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([tag])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("replies", fields: [parentId], references: [id])
  replies   Comment[] @relation("replies")
  reports   Report[]  @relation("reportedComment")

  @@index([postId])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("like")
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  category    String?
  isPublic    Boolean  @default(true)
  rules       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
  members     CommunityMember[]
  reports     Report[]  @relation("reportedCommunity")

  @@index([category])
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  role        String   @default("member")
  joinedAt    DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
}

model MessageThread {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   ThreadMember[]
  messages  Message[]
}

model ThreadMember {
  id        String        @id @default(cuid())
  userId    String
  threadId  String
  lastRead  DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
}

model Message {
  id        String        @id @default(cuid())
  content   String
  senderId  String
  threadId  String
  createdAt DateTime      @default(now())
  sender    User          @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  recipientId String
  actorId     String?
  postId      String?
  message     String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient   User     @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  post        Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([createdAt])
}

model Report {
  id                String     @id @default(cuid())
  reason            String
  status            String     @default("pending")
  reporterId        String
  reportedUserId    String?
  reportedPostId    String?
  reportedCommentId String?
  reportedCommunityId String?
  createdAt         DateTime   @default(now())

  reporter          User       @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser      User?      @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedPost      Post?      @relation("reportedPost", fields: [reportedPostId], references: [id], onDelete: SetNull)
  reportedComment   Comment?   @relation("reportedComment", fields: [reportedCommentId], references: [id], onDelete: SetNull)
  reportedCommunity Community? @relation("reportedCommunity", fields: [reportedCommunityId], references: [id], onDelete: SetNull)
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Mute {
  id      String   @id @default(cuid())
  muterId String
  mutedId String
  createdAt DateTime @default(now())

  muter   User     @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted   User     @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  adminId   String
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ConnectedAccount {
  id           String   @id @default(cuid())
  userId       String
  platform     String
  platformUsername String?
  platformId   String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  // OAuth scopes granted by the platform
  scopes       String?
  isActive     Boolean  @default(true)
  // Last successful sync timestamp
  lastSyncAt   DateTime?
  // Sync status: "idle" | "syncing" | "error" | "rate_limited"
  syncStatus   String   @default("idle")
  syncError    String?
  // Optional association with an alter ego / persona
  alterEgoId   String?
  // Label to distinguish multiple accounts on the same platform
  accountLabel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alterEgo     AlterEgo? @relation(fields: [alterEgoId], references: [id], onDelete: SetNull)
  platformPosts PlatformPost[]
  platformComments PlatformComment[]
  platformMedia PlatformMedia[]
  platformFollowers PlatformFollower[]
  syncJobs     SyncJob[]
  platformAnalytics PlatformAnalytics[]

  @@index([userId, platform])
  @@index([platform])
  @@index([alterEgoId])
}

// ─── Cross-Platform Content Sync ────────────────────────────

model PlatformPost {
  id                String   @id @default(cuid())
  connectedAccountId String
  // Original post ID on the platform
  platformPostId    String
  // Post content / caption / description
  content           String?
  // Post title (YouTube videos, Reddit posts, etc.)
  title             String?
  // Direct URL to the post on the platform
  url               String?
  // Post type: "text" | "image" | "video" | "story" | "reel" | "short" | "tweet" | "thread" | "article" | "pin" | "snap"
  postType          String   @default("text")
  // Engagement metrics
  likeCount         Int      @default(0)
  commentCount      Int      @default(0)
  shareCount        Int      @default(0)
  viewCount         Int      @default(0)
  // Video-specific metrics
  watchTimeSeconds  Int?
  // Post visibility: "public" | "private" | "unlisted" | "friends"
  visibility        String   @default("public")
  // Whether this post was created from mesh.me (cross-posted)
  isFromMesh        Boolean  @default(false)
  // Whether we've imported comments for this post
  commentsImported  Boolean  @default(false)
  // Original publish timestamp from the platform
  publishedAt       DateTime?
  // Thumbnail / preview image URL
  thumbnailUrl      String?
  // Raw JSON metadata from platform API
  rawMetadata       String?
  // Is this post pinned on the platform?
  isPinned          Boolean  @default(false)
  // Is this a scheduled post?
  isScheduled       Boolean  @default(false)
  scheduledFor      DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  comments          PlatformComment[]
  media             PlatformMedia[]

  @@unique([connectedAccountId, platformPostId])
  @@index([connectedAccountId])
  @@index([publishedAt])
  @@index([postType])
}

model PlatformComment {
  id                String   @id @default(cuid())
  connectedAccountId String
  platformPostId    String?
  platformCommentId String
  // The post this comment belongs to (if synced)
  postId            String?
  // Comment text
  content           String
  // Author info from the platform
  authorName        String?
  authorUsername    String?
  authorAvatarUrl  String?
  // Is this the connected user's own comment?
  isOwnComment      Boolean  @default(false)
  // Engagement
  likeCount         Int      @default(0)
  replyCount        Int      @default(0)
  // Parent comment ID (for threaded comments)
  parentCommentId   String?
  // Direct URL to the comment
  url               String?
  // Sentiment: "positive" | "negative" | "neutral" | "question"
  sentiment         String?

  publishedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  post              PlatformPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformCommentId])
  @@index([connectedAccountId])
  @@index([postId])
}

model PlatformMedia {
  id                String   @id @default(cuid())
  connectedAccountId String
  platformMediaId   String?
  // Associated platform post
  postId            String?
  // Media type: "image" | "video" | "audio" | "gif" | "document"
  mediaType         String   @default("image")
  // URL to the media file
  url               String
  // Thumbnail URL
  thumbnailUrl      String?
  // Alt text / description
  altText           String?
  // Media dimensions
  width             Int?
  height            Int?
  // Duration in seconds (for video/audio)
  durationSeconds   Int?
  // File size in bytes
  fileSizeBytes     Int?
  // MIME type
  mimeType          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  post              PlatformPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@index([postId])
}

model PlatformFollower {
  id                String   @id @default(cuid())
  connectedAccountId String
  // Platform user ID
  platformUserId    String
  // Username on the platform
  username          String?
  // Display name
  displayName       String?
  // Profile picture URL
  avatarUrl         String?
  // Follower count on that platform
  followerCount     Int?
  // Is this a mutual follow?
  isMutual          Boolean  @default(false)
  // Type: "follower" | "following" | "subscriber" | "friend"
  relationshipType  String   @default("follower")
  // Profile URL
  profileUrl        String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, platformUserId])
  @@index([connectedAccountId])
}

model PlatformAnalytics {
  id                String   @id @default(cuid())
  connectedAccountId String
  // Date for this analytics snapshot
  date              DateTime
  // Follower/subscriber count at this point
  followerCount     Int      @default(0)
  followingCount    Int      @default(0)
  // Engagement metrics for the day
  postCount         Int      @default(0)
  totalLikes        Int      @default(0)
  totalComments     Int      @default(0)
  totalViews        Int      @default(0)
  totalShares       Int      @default(0)
  // Growth metrics
  newFollowers      Int      @default(0)
  lostFollowers     Int      @default(0)
  // Engagement rate (percentage * 100 for precision)
  engagementRate    Int?
  // Top-performing post ID for the day
  topPostId         String?
  // Raw JSON for platform-specific analytics
  rawData           String?

  createdAt         DateTime @default(now())

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, date])
  @@index([connectedAccountId])
  @@index([date])
}

model SyncJob {
  id                String   @id @default(cuid())
  connectedAccountId String
  // Sync type: "full" | "incremental" | "posts" | "comments" | "followers" | "analytics" | "media"
  syncType          String   @default("full")
  // Status: "pending" | "running" | "completed" | "failed" | "cancelled"
  status            String   @default("pending")
  // Progress (0-100)
  progress          Int      @default(0)
  // Items synced / total
  itemsSynced       Int      @default(0)
  totalItems        Int?
  // Error message if failed
  error             String?
  // Timing
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  connectedAccount  ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([connectedAccountId])
  @@index([status])
}

model FeedPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  layout    String   @default("cards")
  sources   String   @default("all")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Achievements & Titles ──────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  category    String   @default("general")
  title       String?
  threshold   Int      @default(1)
  isLimited   Boolean  @default(false)
  maxHolders  Int?
  createdAt   DateTime @default(now())

  holders     UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── Meshi AI Preferences ───────────────────────────────────

model MeshiPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  hatStyle    String   @default("none")
  faceStyle   String   @default("happy")
  colorTheme  String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Mesh Cosmetics (MeshPro) ───────────────────────────────

model MeshCosmetic {
  id          String   @id @default(cuid())
  userId      String
  type        String
  value       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Mesh Privacy Controls ──────────────────────────────────

model MeshPrivacy {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Overall mesh visibility: "private" | "friends" | "public" | "partial"
  meshVisibility  String   @default("friends")
  // Per-branch visibility overrides (JSON: { "people": "public", "communities": "friends", ... })
  branchOverrides String   @default("{}")
  // Whether connections (edges) are visible to others
  showConnections Boolean  @default(true)
  // Whether stats are visible to others
  showStats       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Global Mesh (opt-in) ───────────────────────────────────

model GlobalMeshMember {
  id              String   @id @default(cuid())
  userId          String   @unique
  isActive        Boolean  @default(true)
  // JSON array of branch types shared with global mesh: ["people","communities","interests"]
  sharedBranches  String   @default("[]")
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Sessions (DB-backed for serverless) ─────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Alter Egos (Account Merging) ────────────────────────────

model AlterEgo {
  id          String   @id @default(cuid())
  userId      String
  username    String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccounts ConnectedAccount[]

  @@index([userId])
}

// ─── Multi-Email & Multi-Phone ──────────────────────────────

model UserEmail {
  id         String   @id @default(cuid())
  userId     String
  email      String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPhone {
  id         String   @id @default(cuid())
  userId     String
  phone      String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Two-Factor Authentication ──────────────────────────────

model TwoFactorMethod {
  id         String   @id @default(cuid())
  userId     String
  // Method type: "email" | "sms" | "totp" | "passkey"
  method     String
  // For TOTP: encrypted secret; for passkey: credential ID
  secret     String?
  // For passkey: public key
  publicKey  String?
  // User-friendly label (e.g. "My iPhone", "Google Authenticator")
  label      String?
  isEnabled  Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Account Merge Requests ─────────────────────────────────

model AccountMergeRequest {
  id              String   @id @default(cuid())
  // The account that will remain (primary)
  primaryUserId   String
  // The account that will be merged in (secondary → becomes alter ego)
  secondaryEmail  String
  // Status: "pending" | "verified" | "completed" | "rejected"
  status          String   @default("pending")
  // Verification token sent to secondary account email
  verifyToken     String?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([primaryUserId])
  @@index([secondaryEmail])
}

// ─── Profile Info (Facebook-level fields with per-field privacy) ──

model ProfileInfo {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Extended bio / "About me"
  aboutMe         String?
  // Work & Education
  workplace       String?
  jobTitle        String?
  school          String?
  // Personal details
  birthday        String?
  gender          String?
  pronouns        String?
  hometown        String?
  currentCity     String?
  relationshipStatus String?
  // Contact info (beyond primary email/phone)
  publicEmail     String?
  publicPhone     String?

  // Per-field privacy: JSON map of field → "public" | "friends" | "personal"
  // e.g. { "birthday": "friends", "workplace": "public", "publicPhone": "personal" }
  fieldPrivacy    String   @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Redeem Codes ────────────────────────────────────────────

model RedeemCode {
  id          String    @id @default(cuid())
  code        String    @unique
  // What the code unlocks: "meshi-face", "meshi-hat", "meshi-color", "mesh-cosmetic"
  rewardType  String
  // The value of the reward (e.g. face name, hat name, color name)
  rewardValue String
  // Display label for the reward
  rewardLabel String
  // Whether the code has been used
  redeemedBy  String?
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
}
