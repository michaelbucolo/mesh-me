/// Cross-instance rate-limit + lockout counters. In-memory Maps reset on every
/// serverless cold start and are per-instance, so this durably backs the
/// sensitive auth endpoints (login lockout, signup, password reset). Reads and
/// writes fail open — a DB hiccup degrades to no limiting, never a lockout.
model RateLimitHit {
  key         String    @id
  count       Int       @default(0)
  resetAt     DateTime
  lockedUntil DateTime?
  lockCount   Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@index([resetAt])
}

/// PUBLIC CONTENT THAT BELONGS TO NO MESH.ME ACCOUNT.
///
/// Every other content model in this schema hangs off ConnectedAccount:
/// PlatformPost.connectedAccountId, PlatformFeedItem.connectedAccountId. That
/// is why a new account's Flow is empty and stays empty — there was literally
/// nowhere to put a video that nobody here had connected an account to fetch.
/// The product's whole premise ("browse every platform from mesh.me without
/// connecting anything") had no table.
///
/// This is that table. A row is public content fetched from a platform's
/// OFFICIAL API using MESH.ME'S OWN app credentials — never a user's, never by
/// scraping. It is attributed to its real author on the source platform, and
/// it links back there.
///
/// `expiresAt` IS A COMPLIANCE MECHANISM, NOT A CACHE HINT. Several platforms
/// cap how long a third party may retain API results. Every read filters on it
/// and a sweep deletes past it, so "we keep this only as long as their terms
/// allow" is enforced by the schema rather than promised in a comment.
model PublicPost {
  id             String @id @default(cuid())
  /// Source platform id, matching platform-capabilities.ts (youtube, twitch, …).
  platform       String
  /// The id this item has ON that platform. Unique with platform, so refetching
  /// updates in place instead of duplicating the Flow.
  platformPostId String
  /// Which provider lane produced it, e.g. "youtube:mostPopular". Lets one
  /// misbehaving lane be disabled without dropping a whole platform.
  lane           String

  title           String?
  content         String?
  url             String?
  postType        String  @default("video")
  thumbnailUrl    String?
  mediaUrl        String?
  /// Real length from the source. The Flow is shorts-only and EXCLUDES what it
  /// cannot classify, so an absent duration means the item never plays there.
  durationSeconds Int?
  /// BCP-47-ish language tag when the platform reports one.
  lang            String?

  authorName      String?
  authorUsername  String?
  authorAvatarUrl String?
  authorUrl       String?

  viewCount    Int @default(0)
  likeCount    Int @default(0)
  commentCount Int @default(0)

  /// Safety classification, same contract as PlatformPost: hidden unless the
  /// viewer is adult-verified AND has explicitly opted in.
  isNsfw        Boolean @default(false)
  contentRating String  @default("general")

  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  /// Hard retention limit from the source platform's terms. Reads filter on it.
  expiresAt   DateTime

  @@unique([platform, platformPostId])
  @@index([platform, publishedAt])
  @@index([expiresAt])
  @@index([lane, fetchedAt])
}

/// One fetch of one lane, kept so the supply is observable and honest.
///
/// Without this, "the Flow is empty" has two indistinguishable causes: nobody
/// configured a key, or the fetch is failing. That ambiguity is what lets a
/// broken feed look like a quiet one. The public-supply status surface reads
/// these rows, so what a user is told matches what actually happened.
model PublicSupplyRun {
  id           String   @id @default(cuid())
  platform     String
  lane         String
  /// "ok" | "not_configured" | "rate_limited" | "error"
  status       String
  itemsFetched Int      @default(0)
  itemsStored  Int      @default(0)
  /// Message safe to show an operator. Never contains a credential.
  detail       String?
  durationMs   Int      @default(0)
  startedAt    DateTime @default(now())

  @@index([platform, startedAt])
  @@index([startedAt])
}
