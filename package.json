    "flow-form:check": "node --import tsx scripts/flow-form-check.ts",
    "meshi-act:check": "node --import tsx scripts/meshi-act-check.ts",
    "surface:check": "node --import tsx scripts/surface-check.ts",
    "meshpro-claims:check": "node --import tsx scripts/meshpro-claims-check.ts",
    "public-supply:check": "node --import tsx scripts/public-supply-check.ts",
    "platform-allowlist:check": "node --import tsx scripts/platform-allowlist-check.ts",
    "platform-name:check": "node --import tsx scripts/platform-name-check.ts",
    "oauth-config:check": "node --import tsx scripts/oauth-config-check.ts",
    "mesh-chrome:check": "node --import tsx scripts/mesh-chrome-check.ts",
    "nav-icons:check": "node --import tsx scripts/nav-icons-check.ts",
    "glass:check": "node --import tsx scripts/glass-check.ts",
    "aria:check": "node --import tsx scripts/aria-check.ts",
    "hierarchy:check": "node --import tsx scripts/hierarchy-check.ts",
    "grouped-list:check": "node --import tsx scripts/grouped-list-check.ts",
    "meshi-occlusion:check": "node --import tsx scripts/meshi-occlusion-check.ts",
    "meshi-marks:check": "node --import tsx scripts/meshi-marks-check.ts",
    "component-glass:check": "node --import tsx scripts/component-glass-check.ts",
    "platform-logo:check": "node --import tsx scripts/platform-logo-check.ts",
    "viewport:sweep": "node scripts/viewport-sweep.mjs",
    "oauth-precondition:check": "node --import tsx scripts/oauth-precondition-check.ts",
    "portability-claim:check": "node --import tsx scripts/portability-claim-check.ts",
    "portability-parse:check": "node --import tsx scripts/portability-parse-check.ts",
    "reachability:check": "node --import tsx scripts/reachability-check.ts",
    "room-identity:check": "node --import tsx scripts/room-identity-check.ts",
    "achievement:check": "node --import tsx scripts/achievement-check.ts",
