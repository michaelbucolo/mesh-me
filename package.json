{
  "name": "mesh-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && node scripts/ensure-remote-schema.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "dead-code:check": "knip --no-progress",
    "prod-schema-parity:check": "node --import tsx scripts/prod-schema-parity-check.ts",
    "schema:check": "prisma migrate diff --exit-code --from-migrations prisma/migrations --to-schema prisma/schema.prisma",
    "check": "npm run foundation:check && npm run schema:check && npm run prod-schema-parity:check && npm run lint && npm run dead-code:check && npm run privacy:check && npm run contrast:check && npm run glass:check && npm run component-glass:check && npm run aria:check && npm run hierarchy:check && npm run grouped-list:check && npm run meshi-occlusion:check && npm run meshi-marks:check && npm run palette:check && npm run meshi:singleton && npm run profile-links:check && npm run founder-pro:check && npm run meshpro-name:check && npm run meshpro-claims:check && npm run public-supply:check && npm run platform-allowlist:check && npm run platform-name:check && npm run platform-logo:check && npm run oauth-config:check && npm run oauth-precondition:check && npm run mesh-chrome:check && npm run nav-icons:check && npm run pen:check && npm run studio-reach:check && npm run view-controls:check && npm run silent-selection:check && npm run type:check && npm run consent:check && npm run disconnect:check && npm run second-writer:check && npm run email-claim:check && npm run claim-truth:check && npm run unified-claim:check && npm run portability-claim:check && npm run portability-parse:check && npm run reachability:check && npm run room-identity:check && npm run inventory-claim:check && npm run achievement:check && npm run shape:check && npm run surface:check && npm run cursor:check && npm run meshi:cause-check && npm run mesh:layout-check && npm run mesh:seen-contract && npm run flow-form:check && npm run meshi-act:check && npm run reconciliation:check && npm run launch:check && npm run roadmap:check && npm run diagnostics",
    "verify": "npm run foundation:check && npm run schema:check && npm run prod-schema-parity:check && npm run lint && npm run dead-code:check && npm run privacy:check && npm run mesh:layout-check && npm run mesh:seen-contract && npm run reconciliation:check && npm run build && npm run diagnostics",
    "diagnostics": "node scripts/platform-diagnostics.mjs",
    "diagnostics:strict": "node scripts/platform-diagnostics.mjs --strict --skip-http",
    "foundation:check": "node scripts/foundation-check.mjs",
    "privacy:check": "node --import tsx scripts/privacy-policy-check.ts",
    "consent:check": "node --conditions=react-server --import tsx scripts/consent-check.ts",
    "shape:check": "node --import tsx scripts/shape-check.ts",
    "claim-truth:check": "node --import tsx scripts/claim-truth-check.ts",
    "unified-claim:check": "node --import tsx scripts/unified-claim-check.ts",
    "email-claim:check": "node --import tsx scripts/email-claim-check.ts",
    "second-writer:check": "node --import tsx scripts/second-writer-check.ts",
    "disconnect:check": "node --import tsx scripts/disconnect-purge-check.ts",
    "cursor:check": "node --import tsx scripts/cursor-check.ts",
    "meshi:cause-check": "node --import tsx scripts/meshi-cause-check.ts",
    "cursor:build": "node scripts/build-cursor-png.mjs",
    "mesh:layout-check": "node --import tsx scripts/mesh-layout-determinism.ts",
    "mesh:live-contract": "node --import tsx scripts/mesh-live-contract.ts",
    "mesh:seen-contract": "node --import tsx scripts/mesh-seen-bridge-contract.ts",
    "mesh:render-parity": "node --import tsx scripts/mesh-render-parity.ts",
    "reconciliation:check": "node --import tsx scripts/reconciliation-check.ts",
    "seed": "node --import tsx prisma/seed.ts",
    "test:smoke": "node scripts/platform-diagnostics.mjs --strict",
    "test:browser": "node scripts/browser-smoke.mjs",
    "drive:smoke": "node scripts/drive-smoke.mjs",
    "test:stress": "node scripts/live-stress.mjs",
    "troubleshoot": "node scripts/platform-diagnostics.mjs --strict",
    "cap:sync": "npx cap sync ios",
    "cap:open": "npx cap open ios",
    "cap:build": "npm run build && npm run cap:sync",
    "build:ios": "npm run build && npm run cap:sync",
    "launch:check": "node scripts/launch-readiness.mjs",
    "roadmap:check": "node scripts/roadmap-readiness.mjs",
    "contrast:check": "node --import tsx scripts/contrast-check.ts",
    "palette:check": "node --import tsx scripts/palette-check.ts",
    "meshi:singleton": "node --import tsx scripts/meshi-singleton-check.ts",
    "profile-links:check": "node --import tsx scripts/profile-links-check.ts",
    "founder-pro:check": "node --import tsx scripts/founder-pro-check.ts",
    "view-controls:check": "node --import tsx scripts/view-controls-check.ts",
    "meshpro-name:check": "node --import tsx scripts/meshpro-name-check.ts",
    "pen:check": "node --import tsx scripts/pen-check.ts",
    "studio-reach:check": "node --conditions=react-server --import tsx scripts/studio-reach-check.ts",
    "silent-selection:check": "node --import tsx scripts/silent-selection-check.ts",
