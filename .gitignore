# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# legacy python
__pycache__/
*.py[cod]
.venv/
meshme.db
Thumbs.db
dev.db
prisma/dev.db

.env*.local
.claude/worktrees/

# Throwaway browser-driving scripts and probe output. The reusable harness
# lives in scripts/drive.mjs; anything here is a one-off.
scratchpad/

# Raw research/agent output. Kept out of the repo because it is long, redundant,
# and dated the moment it is written. Anything from it worth keeping gets
# distilled into docs/ — see docs/SURFACE_AUDIT.md, which exists because the
# first copy of that audit was lost to a /tmp sweep.
.research/

# Native SwiftUI app — the Xcode project is GENERATED from project.yml
# (apple/MeshMe/README.md); only the manifest is source.
apple/MeshMe/MeshMe.xcodeproj/
apple/MeshMe/DerivedData/
