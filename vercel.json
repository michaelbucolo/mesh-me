{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"release/launch-experience\" ]",
  "crons": [
    {
      "path": "/api/public-supply/refresh",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/compose/scheduler",
      "schedule": "* * * * *"
    }
  ]
}
