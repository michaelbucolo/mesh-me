{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/meshs-me-troubleshoot-l1xvo4": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    {
      "path": "/api/public-supply/refresh",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/compose/scheduler",
      "schedule": "* * * * *"
    }
  ]
}
